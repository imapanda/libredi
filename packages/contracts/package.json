{
  "name": "@libredi/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Types generated from the schemas in contracts/ (canonical documents, REST API, job envelope), and checks that those files are valid and that services honour them",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "generate": "node src/generate-types.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "catalog:",
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "fast-check": "catalog:",
    "json-schema-to-typescript": "catalog:",
    "jsonata": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "exports": {
    "./canonical/v1": "./src/generated/canonical-v1.ts",
    "./api": "./src/generated/api.ts",
    "./jobs": "./src/generated/jobs.ts",
    "./reference-evaluator": "./src/reference-evaluator.ts"
  }
}
