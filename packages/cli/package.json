{
  "name": "@libredi/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The libredi command line program: inspect an EDIFACT file, build the definition registry",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "libredi": "./src/main.ts"
  },
  "exports": {
    ".": "./src/run.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "libredi": "node src/main.ts"
  },
  "dependencies": {
    "@libredi/edifact": "workspace:*",
    "@libredi/registry": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
